#!/bin/sh
# Launch Autodesk Fusion from the prefix created by install.py
HOME_DIR=$(cd "$(dirname "$0")/.." && pwd)
export WINEPREFIX="${WINEPREFIX:-$HOME_DIR/prefix}"
export WINEDEBUG="${WINEDEBUG:--all}"

# Fusion builds QTWEBENGINE_CHROMIUM_FLAGS itself; this switch makes it add
# --disable-gpu. GPU compositing in the embedded browsers needs D3D11 textures
# shared by NT handle between Chromium and Qt, which Wine's d3dkmt only
# semi-stubs: web views render blank (wined3d) or crash the app (DXVK).
export NEUTRON_CHROME_DISABLE_GPU="${NEUTRON_CHROME_DISABLE_GPU:-1}"
# Chromium starts renderers suspended and resumes them after applying the
# sandbox, which fails under Wine: renderers never run and every web view
# (data panel, home tab, ...) stays blank.
export QTWEBENGINE_DISABLE_SANDBOX=1
# Wine copies child window renderings (the 3D canvas) to the screen without
# waiting for the Vulkan present to finish, so hover highlights often show
# one frame late. This layer makes presents wait (see layer/present_sync.c).
if [ -f "$HOME_DIR/layer/present_sync.json" ]; then
    export VK_ADD_LAYER_PATH="$HOME_DIR/layer${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
    export VK_INSTANCE_LAYERS="VK_LAYER_FUSION4LINUX_present_sync${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"
fi

BUILD=$(dirname "$(ls -d "$WINEPREFIX"/drive_c/users/*/AppData/Local/Autodesk/webdeploy/production/*/Fusion360.exe 2>/dev/null | head -n 1)")
if [ ! -f "$BUILD/Fusion360.exe" ]; then
    echo "Fusion is not installed in $WINEPREFIX; run install.py first" >&2
    exit 1
fi

# Background helpers (Identity Manager, adexmtsv, node) outlive Fusion under
# Wine. A stale Identity Manager keeps pending logins for dead Fusion processes
# and breaks the next sign-in, so start from a clean wineserver unless Fusion is
# already running (in which case just hand the arguments to it).
if pgrep -f 'Fusion360\.exe' >/dev/null; then
    cd "$BUILD" && exec wine Fusion360.exe "$@"
fi
wineserver -k 2>/dev/null
wineserver -w

# Fusion detects Wine and periodically shows an "Unsupported OS" warning. It
# remembers when it last did in PlatformWarningLastShownId; keep that at the
# current time so the warning never comes due.
for OPTIONS in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/Autodesk/"Neutron Platform"/Options/NMachineSpecificOptions.xml; do
    [ -f "$OPTIONS" ] || continue
    python3 - "$OPTIONS" <<'EOF'
import re, sys, time

path = sys.argv[1]
raw = open(path, "rb").read()
encoding = "utf-16" if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else "utf-8"
text = raw.decode(encoding)
now = str(int(time.time()))
option = re.compile(r'(<PlatformWarningLastShownId\b[^>]*\bValue=")\d*(")')
if option.search(text):
    text = option.sub(lambda m: m.group(1) + now + m.group(2), text)
else:
    group = re.search(r"<GeneralOptionGroup\b[^>]*>", text)
    if not group:
        sys.exit()
    text = (text[:group.end()] + '\n        <PlatformWarningLastShownId UserName="PlatformWarningLastShownId" Value="'
            + now + '"/>' + text[group.end():])
open(path, "wb").write(text.encode(encoding))
EOF
done

# Fusion starts the Identity Manager itself, but checks whether it is running
# again before the first instance has registered (process startup is slower
# under Wine) and starts a second one. The two block each other and sign-in
# fails with a misleading firewall error. Start it ourselves, the way Fusion
# does, and wait until it is ready.
IDLOG=$(ls -d "$WINEPREFIX"/drive_c/users/*/AppData/Local/Autodesk/"Identity Services"/Log/IdServices.log 2>/dev/null | head -n 1)
IDLINES=0
[ -f "$IDLOG" ] && IDLINES=$(wc -l < "$IDLOG")
wine "$BUILD/Autodesk Identity Manager/AdskIdentityManager.exe" \
    --process_name Autodesk.IDSDK.DefaultProcess-v2 --server_name Autodesk.IDSDK.DefaultServer-v2 &
for _ in $(seq 60); do
    IDLOG=$(ls -d "$WINEPREFIX"/drive_c/users/*/AppData/Local/Autodesk/"Identity Services"/Log/IdServices.log 2>/dev/null | head -n 1)
    # The log may have been rotated since it was counted
    [ -f "$IDLOG" ] && [ "$(wc -l < "$IDLOG")" -lt "$IDLINES" ] && IDLINES=0
    if [ -f "$IDLOG" ] && tail -n +$((IDLINES + 1)) "$IDLOG" | grep -q "App state set to Running"; then
        break
    fi
    sleep 0.5
done

cd "$BUILD" || exit 1
wine Fusion360.exe "$@"
status=$?

# Fusion has exited: stop the helpers it left behind
wineserver -k 2>/dev/null
exit $status
